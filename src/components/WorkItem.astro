---
interface Props {
    id: string;
    title: string;
    category: string;
    description: string;
    link?: string;
    metrics?: {
        performance: number;
        accessibility: number;
        bestPractices: number;
        seo: number;
    };
}

const { id, title, category, description, link, metrics } = Astro.props;

const getStatusColor = (score: number) => {
    if (score >= 90) return "text-emerald-500";
    if (score >= 80) return "text-amber-500";
    return "text-red-500";
};
---

<a href={link || "#"} target={link ? "_blank" : "_self"} rel={link ? "noopener noreferrer" : ""} class="group relative block py-16 md:py-24 px-4 hover:bg-white transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] cursor-pointer overflow-hidden border-b border-zinc-900/50">
    <!-- Animated background Reveal -->
    <div class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.19,1,0.22,1)]"></div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-12">
        <div class="flex items-start space-x-12">
            <span class="text-[10px] font-mono text-zinc-400 group-hover:text-black transition-colors pt-2">{id}</span>
            <div class="space-y-4">
                <h3 class="text-4xl md:text-6xl font-light tracking-tighter text-white group-hover:text-black transition-colors">
                    {title}
                </h3>
                <div class="flex items-center space-x-4">
                    <span class="inline-block text-[10px] uppercase tracking-[0.4em] text-zinc-400 group-hover:text-zinc-500 transition-colors">
                        {category}
                    </span>
                    
                    {metrics && (
                        <div class="hidden md:flex items-center space-x-3 border-l border-zinc-800 pl-4 group-hover:border-zinc-200 transition-colors">
                            <span class="text-[8px] uppercase tracking-[0.2em] text-zinc-500 font-mono">Metrics:</span>
                            <div class="flex space-x-3 text-[10px] font-mono">
                                <span title="Performance" class={getStatusColor(metrics.performance)}>{metrics.performance}</span>
                                <span title="Accessibility" class={getStatusColor(metrics.accessibility)}>{metrics.accessibility}</span>
                                <span title="Best Practices" class={getStatusColor(metrics.bestPractices)}>{metrics.bestPractices}</span>
                                <span title="SEO" class={getStatusColor(metrics.seo)}>{metrics.seo}</span>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </div>

        <div class="lg:max-w-md w-full">
            <p class="text-zinc-400 group-hover:text-zinc-600 text-sm leading-relaxed font-light transition-colors">
                {description}
            </p>
            
            {metrics && (
                <div class="mt-4 md:hidden flex flex-wrap gap-4 text-[9px] font-mono uppercase tracking-widest">
                    <div class="flex flex-col">
                        <span class="text-zinc-500">Perf</span>
                        <span class={getStatusColor(metrics.performance)}>{metrics.performance}</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-zinc-500">Acc</span>
                        <span class={getStatusColor(metrics.accessibility)}>{metrics.accessibility}</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-zinc-500">BP</span>
                        <span class={getStatusColor(metrics.bestPractices)}>{metrics.bestPractices}</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-zinc-500">SEO</span>
                        <span class={getStatusColor(metrics.seo)}>{metrics.seo}</span>
                    </div>
                </div>
            )}
        </div>

        <div class="flex justify-end lg:pr-4">
            <div class="w-12 h-12 rounded-full border border-zinc-800 group-hover:border-zinc-200 flex items-center justify-center -rotate-45 group-hover:rotate-0 transition-all duration-700">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="stroke-white group-hover:stroke-black transition-colors">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </div>
    </div>
</a>
