---
interface Props {
    id: string;
    title: string;
    category: string;
    description: string;
}

const { id, title, category, description } = Astro.props;
---

<div class="group relative py-16 md:py-24 px-4 hover:bg-white transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] cursor-pointer overflow-hidden border-b border-zinc-900/50">
    <!-- Animated background Reveal -->
    <div class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.19,1,0.22,1)]"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-12">
        <div class="flex items-start space-x-12">
            <span class="text-[10px] font-mono text-zinc-700 group-hover:text-black transition-colors pt-2">{id}</span>
            <div class="space-y-4">
                <h3 class="text-4xl md:text-6xl font-light tracking-tighter text-white group-hover:text-black transition-colors">
                    {title}
                </h3>
                <span class="inline-block text-[10px] uppercase tracking-[0.4em] text-zinc-500 group-hover:text-zinc-400 transition-colors">
                    {category}
                </span>
            </div>
        </div>

        <div class="md:max-w-md">
            <p class="text-zinc-500 group-hover:text-zinc-600 text-sm leading-relaxed font-light transition-colors">
                {description}
            </p>
        </div>

        <div class="flex justify-end pr-4">
            <div class="w-12 h-12 rounded-full border border-zinc-900 flex items-center justify-center -rotate-45 group-hover:rotate-0 transition-all duration-700">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="stroke-white group-hover:stroke-black transition-colors">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </div>
    </div>
</div>
