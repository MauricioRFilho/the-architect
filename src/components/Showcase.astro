---
import WorkItem from "./WorkItem.astro";

const projects = [
    {
        id: "01",
        title: "Bel Gestora",
        category: "Fintech SaaS / Flutter",
        description: "Plataforma completa de gestão financeira para pequenas empresas com foco em UX e performance.",
    },
    {
        id: "02",
        title: "Isa Care",
        category: "HealthTech / Edge Functions",
        description: "Ecossistema de cuidados integrados utilizando Supabase e automações inteligentes.",
    },
    {
        id: "03",
        title: "Sch.IA",
        category: "AI Architecture / LLM",
        description: "Infraestrutura de inteligência artificial aplicada ao workflow de desenvolvimento de elite.",
    }
];
---

<section id="work" class="py-40 px-6 md:px-12 bg-[#050505]">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-32 space-y-8 md:space-y-0">
            <div class="space-y-6">
                <div class="flex items-center space-x-3">
                    <span class="w-1.5 h-1.5 bg-white rotate-45"></span>
                    <span class="text-[10px] uppercase tracking-[0.6em] text-zinc-500 font-mono">Curated Work</span>
                </div>
                <h2 class="text-6xl md:text-8xl font-light tracking-tighter text-white">
                    SELECTED <br/> <span class="italic text-zinc-400">PROJECTS</span>
                </h2>
            </div>
            
            <div class="max-w-xs text-right hidden md:block">
                <p class="text-zinc-500 text-sm leading-relaxed font-light">
                    Uma seleção de experimentos e projetos reais onde a engenharia encontra a estética.
                </p>
            </div>
        </div>

        <div class="flex flex-col mt-12 border-t border-zinc-900">
            {projects.map((project) => (
                <WorkItem {...project} />
            ))}
        </div>

        <div class="mt-24 flex justify-center">
            <button class="px-12 py-4 border border-zinc-800 text-[10px] uppercase tracking-[0.3em] text-zinc-400 hover:bg-white hover:text-black transition-all duration-500 rounded-full">
                View All Archives
            </button>
        </div>
    </div>
</section>
