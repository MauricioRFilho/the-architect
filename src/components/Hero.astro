---
---

<section class="relative min-h-[100vh] flex flex-col justify-center px-6 md:px-12 overflow-hidden bg-[#050505] selection:bg-white selection:text-black">
    <!-- Background Design Elements (Animated Gradients) -->
    <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-white/[0.03] blur-[120px] rounded-full animate-pulse-slow"></div>
    <div class="absolute bottom-[10%] left-[-10%] w-[400px] h-[400px] bg-zinc-800/[0.1] blur-[100px] rounded-full animate-pulse-slow [animation-delay:2s]"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
        <!-- Badge / Label -->
        <div class="flex flex-col space-y-3 mb-12">
            <div class="flex items-center space-x-3">
                <span class="w-1 h-1 rounded-full bg-white animate-pulse"></span>
                <span class="text-[10px] uppercase tracking-[0.5em] text-zinc-500 font-medium">Vol. 01 / Design Engineering</span>
            </div>
            <div class="h-[1px] w-12 bg-zinc-800"></div>
        </div>

        <!-- Main Heading -->
        <h1 class="text-[clamp(4rem,12vw,12rem)] leading-[0.8] font-light tracking-[-0.05em] text-white mb-16 select-none">
            <span class="block overflow-hidden pb-2">
                <span class="block animate-reveal-up whitespace-nowrap uppercase">MAURICIO</span>
            </span>
            <span class="block overflow-hidden italic text-zinc-300">
                <span class="block animate-reveal-up [animation-delay:200ms] whitespace-nowrap uppercase">R. FILHO</span>
            </span>
        </h1>

        <!-- Content Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-end">
            <div class="md:col-span-5 space-y-8">
                <p class="text-zinc-400 text-xl leading-relaxed font-light max-w-md">
                    Orquestrando a interseção entre <span class="text-white">estética brutalista</span> e <span class="text-white">zero latência</span>. Uma vitrine digital impecável para mentes exigentes.
                </p>
                
                <!-- CTA Button -->
                <button class="flex items-center space-x-6 group cursor-pointer bg-transparent border-none outline-none">
                    <div class="w-14 h-14 rounded-full border border-zinc-800 flex items-center justify-center group-hover:bg-white group-hover:border-white group-hover:scale-110 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="stroke-white group-hover:stroke-black transition-colors duration-500">
                            <path d="M7 17L17 7M17 7H7M17 7V17" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="text-[11px] uppercase tracking-[0.3em] text-zinc-500 group-hover:text-white transition-all duration-500 font-semibold underline-offset-8 decoration-zinc-800 group-hover:decoration-white hover:underline">Explorar Arquivos</span>
                </button>
            </div>

            <!-- Performance Stats (Glassmorphism) -->
            <div class="md:col-span-7 flex justify-end">
                <div class="p-8 border border-white/[0.05] bg-white/[0.02] backdrop-blur-3xl rounded-2xl flex flex-col items-end space-y-1 transition-transform hover:scale-105 duration-700 select-none">
                    <span class="text-[5rem] md:text-[8rem] font-bold tracking-tighter text-white leading-none tracking-tighter shadow-2xl">100</span>
                    <div class="flex items-center space-x-2">
                        <div class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
                        <span class="text-[10px] uppercase tracking-[0.4em] text-zinc-500 font-mono">Performance Core Verified</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-10 flex items-center space-x-6">
        <div class="flex flex-col space-y-1">
            <div class="w-1 h-1 rounded-full bg-zinc-800"></div>
            <div class="w-1 h-1 rounded-full bg-zinc-500"></div>
            <div class="w-1 h-12 bg-gradient-to-b from-zinc-500 to-transparent"></div>
        </div>
        <span class="text-[9px] uppercase tracking-[0.6em] text-zinc-600 vertical-text [writing-mode:vertical-rl] animate-pulse">Scroll to explore</span>
    </div>
</section>

<style>
    @keyframes reveal-up {
        from { transform: translateY(110%); }
        to { transform: translateY(0); }
    }
    @keyframes pulse-slow {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.1); }
    }
    .animate-reveal-up {
        animation: reveal-up 1.6s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    }
    .animate-pulse-slow {
        animation: pulse-slow 8s infinite ease-in-out;
    }
    .vertical-text {
        writing-mode: vertical-rl;
    }
</style>
